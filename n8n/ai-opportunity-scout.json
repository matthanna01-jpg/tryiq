    {
      "id": "code1",
      "name": "Filter & Score",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1560, 459],
      "parameters": {
        "jsCode": "const KEYWORDS = ['ai','llm','gpt','claude','gemini','model','api','open-source','open source','launch','release','agent','automation','funding','raised','yc ','y combinator','tool','sdk','framework','startup'];\n\nconst LOOKBACK_HOURS = 14; // a little over the 12h gap between runs to avoid missing items\nconst now = Date.now();\nconst windowMs = LOOKBACK_HOURS * 60 * 60 * 1000;\n\nconst items = $input.all().map(i => i.json).filter(i => i.title);\n\nconst scored = items.map(item => {\n  const text = ((item.title || '') + ' ' + (item.contentSnippet || item.content || item.summary || '')).toLowerCase();\n  let score = 0;\n  for (const kw of KEYWORDS) if (text.includes(kw)) score++;\n  const pubDate = item.isoDate || item.pubDate;\n  const ts = pubDate ? new Date(pubDate).getTime() : now;\n  const recent = (now - ts) <= windowMs;\n  return { title: item.title, link: item.link, score, recent, ts, source: item.source || '' };\n});\n\nconst seen = new Set();\nconst filtered = scored\n  .filter(i => i.recent && i.score >= 2)\n  .filter(i => { const k = i.title.toLowerCase().trim(); if (seen.has(k)) return false; seen.add(k); return true; })\n  .sort((a, b) => b.score - a.score || b.ts - a.ts)\n  .slice(0, 10);\n\nreturn filtered.map(i => ({ json: i }));"
      }
    },
    {
      "id": "code2",
      "name": "Build Digest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1820, 459],
      "parameters": {
        "jsCode": "const items = $input.all().map(i => i.json);\nif (items.length === 0) return [];\n\nconst rows = items.map(i => `<li><a href=\"${i.link}\">${i.title}</a> (score ${i.score})</li>`).join('');\nconst html = `<h2>AI Opportunity Digest — ${new Date().toLocaleString()}</h2><ul>${rows}</ul>`;\n\nreturn [{ json: { subject: `AI Opportunity Digest: ${items.length} finds`, html } }];"
      }
    },
